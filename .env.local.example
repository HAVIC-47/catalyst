# Supabase — copy this file to .env.local and fill in your project's values.
# Find them in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini API key for the memo scanner (/api/scan-memo). Server-only — never prefix it
# with NEXT_PUBLIC_. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional — "Delete account" and the web reminders job. The service-role key is in
# Supabase → Project Settings → API. Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — web reminders (push notifications). Make a key pair once with
#   npx web-push generate-vapid-keys
# and pick any long random CRON_SECRET (set the same value as a GitHub Actions
# secret for .github/workflows/reminders.yml).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
CRON_SECRET=a-long-random-string
# Optional — the contact the push services see (defaults to the site's https URL).
# VAPID_SUBJECT=mailto:you@example.com

# Optional — show "Continue with Google" once the Google provider is set up in
# Supabase (Authentication → Providers → Google).
# NEXT_PUBLIC_GOOGLE_SIGN_IN=on
